# Machine-specific config (keep hardware configs in version control for this multi-host setup)
# hardware-configuration.nix

# Secrets yaml folder (encrypted files are safe to commit)
/secrets/*.yaml
!/secrets/secrets.yaml
!/secrets/secrets.yaml.example
*.key
*.pem
*.crt
*.enc
*.age
*.gpg

# Local overrides you might create
*.secret.nix
*.local.nix

# Editor/IDE stuff
*.swp
*.swo
.vscode/
.idea/

# Build / temporary files
result
result-*
*.bak
